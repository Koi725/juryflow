# Copy to .env and fill in. .env is gitignored.

# PostgreSQL
POSTGRES_DB=juryflow
POSTGRES_USER=juryflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Server
SERVER_PORT=8080
TOKEN_TTL=8h

# Initial admin professor, created on first start only if the users table is empty.
# Password must have at least 8 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
